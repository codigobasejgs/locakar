# Copie para .env.local (local) e cadastre as mesmas variáveis na Vercel.
# Sem estas variáveis o painel roda em modo demonstração (localStorage).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Somente servidor (Vercel), nunca NEXT_PUBLIC_. Gerar: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:locakarveiculos@gmail.com

# InfinitePay: nenhuma variável necessária (InfiniteTap e Checkout Integrado não usam API key).
# A InfiniteTag fica em Configurações → InfinitePay. URL pública usada em webhook/redirect (opcional):
# NEXT_PUBLIC_SITE_URL=https://www.locakar.com.br

# Selsyn: chave exclusiva do backend (nunca NEXT_PUBLIC_). Base oficial fixa /keek/rest/.
SELSYN_API_KEY=
# ID (uuid) da locadora dona da SELSYN_API_KEY. Sem ele as rotas Selsyn ficam bloqueadas (isolamento entre locadoras).
SELSYN_ORGANIZATION_ID=
# Polling opcional somente de posições, aba visível; mínimo interno de 30 segundos.
SELSYN_POSITION_REFRESH_SECONDS=120
# Comandos físicos: habilitar somente após migration, cadastro do IMEI e homologação supervisionada.
SELSYN_COMMANDS_ENABLED=false

# Asaas: a API Key é cadastrada em Configurações → Asaas e fica CIFRADA no banco (AES-256-GCM).
# Chave mestra só no servidor (nunca NEXT_PUBLIC_). Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar esta chave invalida as API Keys salvas (será preciso cadastrá-las de novo).
ASAAS_ENCRYPTION_KEY=

# Autentique: token e segredo do webhook de cada locadora ficam CIFRADOS no banco (AES-256-GCM).
# Chave mestra só no servidor, 32 bytes em base64. Trocar invalida tokens e segredos salvos.
# SIGNATURE_PROVIDER=mock usa o provider falso (somente testes locais).
SIGNATURE_ENCRYPTION_KEY=

# FIPE: token opcional cadastrado no Admin; chave mestra server-only para cifra AES-256-GCM.
FIPE_CONFIG_ENCRYPTION_KEY=
