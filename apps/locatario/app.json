{
  "expo": {
    "name": "LOCAKAR",
    "slug": "locakar-locatario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "locakar",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.locakar.locatario",
      "associatedDomains": ["applinks:www.locakar.com.br"],
      "infoPlist": {
        "NSCameraUsageDescription": "A LOCAKAR usa a câmera quando você fotografa um comprovante, a vistoria do carro, uma ocorrência ou seus documentos.",
        "NSPhotoLibraryUsageDescription": "A LOCAKAR acessa a galeria quando você escolhe um comprovante, uma foto do carro ou um documento para enviar.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.locakar.locatario",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png",
      "name": "LOCAKAR · App do Locatário",
      "shortName": "LOCAKAR",
      "themeColor": "#050505",
      "backgroundColor": "#050505"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A LOCAKAR acessa a galeria quando você escolhe um comprovante, uma foto do carro ou um documento para enviar.",
          "cameraPermission": "A LOCAKAR usa a câmera quando você fotografa um comprovante, a vistoria do carro, uma ocorrência ou seus documentos.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A000A0"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/locatario"
    },
    "extra": {
      "eas": {
        "projectId": ""
      },
      "playIntegrityCloudProject": ""
    }
  }
}
