{
  "expo": {
    "name": "LOCAKAR",
    "slug": "locakar-locatario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../../public/icons/icon-512.png",
    "scheme": "locakar",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "../../public/icons/icon-512.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.locakar.locatario",
      "infoPlist": {
        "NSCameraUsageDescription": "A LOCAKAR precisa de acesso à câmera para fotografar vistorias, comprovantes e assinar contratos.",
        "NSPhotoLibraryUsageDescription": "A LOCAKAR precisa de acesso à galeria para enviar comprovantes de pagamento e fotos da vistoria."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../../public/icons/icon-512.png",
        "backgroundColor": "#050505"
      },
      "package": "com.locakar.locatario",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita o acesso às suas fotos para anexar comprovantes de pagamento."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
